# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Data: raw images ARE versioned; compressed archives are not (GitHub 100 MB file limit)
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz

# Preprocessed image cache (regenerated by the notebook)
data/cache/

# Trained weights: ignored by default. The weights and results of the v2 solution ARE versioned
# (~1.2 MB per .pt) so that notebooks/01_solucion_cnn_mri_v2.ipynb runs without retraining.
outputs/models/*
!outputs/models/.gitkeep
!outputs/models/mricnn_best.pt
!outputs/models/mricnn_history.csv
!outputs/models/exp_*.json
!outputs/models/exp_*.pt
!outputs/models/resultados_test.csv
!outputs/models/resumen_informe.json

# Local tooling files (not part of the project)
skill/

# Smoke-test outputs (quick mode)
outputs/_smoke_test/

# LaTeX build files
report/*.aux
report/*.log
report/*.out
report/*.synctex.gz
report/*.fdb_latexmk
report/*.fls
report/*.bbl
report/*.blg

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
